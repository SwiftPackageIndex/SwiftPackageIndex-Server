variables:
    base_url: http://localhost:8080/api
    # base_url: https://staging.swiftpackageindex.com/api
    # set here or via env variables:
    # env version_id=... builder_token=... rester ...
    # version_id:
    # builder_token:

requests:

    post build:
        url: ${base_url}/versions/${version_id}/build-report
        method: POST
        headers:
            Authorization: Bearer ${builder_token}
        body:
            json:
                buildId: ${build_id}
                platform: macos-spm
                status: ok
                swiftVersion:
                    major: 6
                    minor: 3
                    patch: 0

        validation:
            status: 204
        log: json
